{
  "framework": null,
  "installCommand": "",
  "buildCommand": "",
  "outputDirectory": ".",
  "trailingSlash": true,
  "functions": {
    "api/render.js": { "includeFiles": "{app.html,coming-soon.html}" }
  },
  "redirects": [
    { "source": "/app.html", "destination": "/", "permanent": true },
    { "source": "/index.html", "destination": "/", "permanent": true }
  ],
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/:path((?!api/|assets/|js/|admin/|.*\\.[a-zA-Z0-9]{2,5}$).*)", "destination": "/api/render?__p=/:path" }
  ],
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=2592000" }] },
    { "source": "/js/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }] },
    { "source": "/admin/(.*)", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }, { "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/coming-soon.html", "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }] },
    { "source": "/VendorTile2.dc.html", "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }] }
  ]
}
